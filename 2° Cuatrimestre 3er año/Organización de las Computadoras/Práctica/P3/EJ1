#Implementa una función que intercambie dos valores usando solo el stack. 
# Entrada: a0 = valor1, a1 = valor2 
# Salida: a0 = valor2, a1 = valor1 
#intercambiar: 
#¡Implementa usando push/pop! 
#ret

.data
	valor1: .word 10
	valor2: .word 20
	
.text
.global main

main:
	#Push de valores al stack
	lw t0,valor1 	#Carga el valor1 en t0
	addi sp,sp,-4	#Reserva espacio en stack
	sw t0, 0(sp)	#Guardar t0 en stack
	
	lw t1,valor2	#Cargar valor2 en t1
	addi sp,sp,-4	#Reserva espacio
	sw t1,0(sp)		#Guarda t1 en stack

	# Pop devalores del stack
 	lw t0, 0(sp)	# Cargar último valor
 	addi sp, sp, 4	# Liberar espacio
 	lw t1, 0(sp) 	# Cargar primer valor
 	addi sp, sp, 4	# Liberar espaci
 

 
	  
	   
	    
	      