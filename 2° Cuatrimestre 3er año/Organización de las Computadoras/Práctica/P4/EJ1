.data
	texto: .string "Hola SRV"
	
.text
.global main

main:
	la t0,texto		#Dirección Inicio String
	lb t1,0(t0)
	
	loop:
		beq t1,x0,dire_fin
		addi t0,t0,1
		lb t1,0(t0)
		j loop
	dire_fin:
		add t1,x0,t0	#t1 Dirección final
		
	la t0,texto		#Dirección Inicial
	addi t1,t1,-1	#Direccion Final
	
	loop_while:
		lb t2,0(t0)		#t2 toma el valor inicial
		lb t3,0(t1)		#t3 toma el valor final
		add t4,x0,t2
		sb t3,0(t0)
		sb t4,0(t1)
		
		addi t0,t0,1
		addi t1,t1,-1
		
		blt t0,t1,loop_while