
.data
	resultado: .word 0

.text
.global main

main:
	li t0,15
	li t1,5
	
	#---Suma---
	la t2, resultado
	add t3,t0,t1
	sw t3,0(t2)
	#---Resta---
	addi t2,t2,4
	sub t3,t0,t1
	sw t3,0(t2)
	#---Division---
	addi t2,t2,4
	div t3,t0,t1
	sw t3,0(t2)
	#---Multiplicacion---
	addi t2,t2,4
	mul t3,t0,t1
	sw t3,0(t2)
	
	ret
	
	
	
	
	
	
	
	
