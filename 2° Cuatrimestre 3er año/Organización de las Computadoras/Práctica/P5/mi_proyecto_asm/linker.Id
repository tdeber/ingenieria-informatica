
MEMORY { 
    iram (rwx) : org = 0x40380000, len = 0x20000  /* IRAM del 
ESP32-C3 */ 
    dram (rw)  : org = 0x3FC80000, len = 0x20000  /* DRAM del 
ESP32-C3 */ 
} 
 
ENTRY(_start) 
 
SECTIONS { 
    /* Sección de vectores (opcional para ASM puro) */ 
    .vectors : { 
        *(.vectors) 
    } > iram 
 
    /* Sección de código principal */ 
    .text : ALIGN(4) { 
        *(.text) 
        *(.text.*) 
        *(.gnu.linkonce.t.*) 
        *(.stub) 
    } > iram 
 
    /* Sección de datos de solo lectura */ 
    .rodata : ALIGN(4) { 
        *(.rodata) 
        *(.rodata.*) 
        *(.gnu.linkonce.r.*) 
    } > dram 
 
    /* Sección de datos inicializados */ 
    .data : ALIGN(4) { 
        _data_start = .; 
        *(.data) 
        *(.data.*) 
        *(.gnu.linkonce.d.*) 
        _data_end = .; 
    } > dram 
 
    /* Sección BSS (datos no inicializados) */ 
    .bss : ALIGN(4) { 
        _bss_start = .; 
        *(.bss) 
        *(.bss.*) 
        *(.gnu.linkonce.b.*) 
        *(COMMON) 
        _bss_end = .; 
    } > dram 
 
    /* Configuración del stack */ 
    .stack (NOLOAD) : ALIGN(16) { 
        _stack_start = .; 
        . += 0x2000; /* 8KB de stack */ 
        _stack_end = .; 
    } > dram 
 
    /* ==================== */ 
    /* SECCIONES DE DEPURACIÓN */ 
    /* ==================== */ 
     
    /* Secciones DWARF 1 */ 
    .debug          0 : { *(.debug) } 
    .line           0 : { *(.line) } 
     
    /* Secciones DWARF 2 */ 
    .debug_info     0 : { *(.debug_info) } 
    .debug_abbrev   0 : { *(.debug_abbrev) } 
    .debug_line     0 : { *(.debug_line) } 
    .debug_frame    0 : { *(.debug_frame) } 
    .debug_str      0 : { *(.debug_str) } 
    .debug_loc      0 : { *(.debug_loc) } 
    .debug_macinfo  0 : { *(.debug_macinfo) } 
     
    /* Secciones DWARF 3 */ 
    .debug_pubnames 0 : { *(.debug_pubnames) } 
    .debug_pubtypes 0 : { *(.debug_pubtypes) } 
     
    /* Secciones DWARF 4 */ 
    .debug_aranges  0 : { *(.debug_aranges) } 
    .debug_ranges   0 : { *(.debug_ranges) } 
     
    /* Secciones DWARF 5 */ 
    .debug_addr     0 : { *(.debug_addr) } 
    .debug_line_str 0 : { *(.debug_line_str) } 
    .debug_loclists 0 : { *(.debug_loclists) } 
    .debug_rnglists 0 : { *(.debug_rnglists) } 
     
    /* Símbolos para el debugger */ 
    .comment       0 : { *(.comment) } 
    .note.gnu.build-id : { *(.note.gnu.build-id) } 
 
    /* Variables para el debugger */ 
    _iram_start = ORIGIN(iram); 
    _iram_end = ORIGIN(iram) + LENGTH(iram); 
    _dram_start = ORIGIN(dram); 
    _dram_end = ORIGIN(dram) + LENGTH(dram); 
}