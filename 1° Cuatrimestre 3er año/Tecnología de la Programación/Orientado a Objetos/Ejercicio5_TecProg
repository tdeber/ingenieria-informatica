        self.stock = stock

    def verStock(self):
        print(self.stock)
    
    def modStock(self,cant):
        self.stock += cant

    def verPrecio(self):
        return self.precio
    
    def __str__(self):
        return F"{self.nombre}"


class Factura:
    def __init__(self, numero, cliente):
        self.numero = numero
        self.fecha = datetime.date.today()
        self.cliente = cliente
        self.productos = []
        self.cantidad = []
        self.monto = 0 

    def agregarProducto(self, producto, cant):
        self.productos.append(producto)
        self.cantidad.append(cant)
        self.actualizarMonto(producto.verPrecio(), cant)
    
    def actualizarMonto(self, precio, cant):
        self.monto += (precio*cant)

    def verMonto(self):
        return self.monto


class Cliente:
    def __init__(self, nombre, cuit):
        self.nombre = nombre
        self.cuit = cuit

    def __str__(self):
        return F"{self.nombre} - {self.cuit}"
    

