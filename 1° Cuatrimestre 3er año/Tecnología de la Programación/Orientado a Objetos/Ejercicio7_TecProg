import datetime

class Concesionaria:
    def __init__(self, nombre):
        self.nombre = nombre
        self.autos = []
        self.camionetas = []
        self.motos = []
        self.accesorios = []
        self.ventas = []
    
    def agregarAuto(self, auto):
        self.autos.append(auto)
    
    def agregarCamioneta(self, camioneta):
        self.camionetas.append(camioneta)

    def agregarMoto(self, moto):
        self.motos.append(moto)
    
    def agregarAccesorio(self, accesorio):
        self.accesorios.append(accesorio)
    
    def agregarVenta(self, venta):
        self.ventas.append(venta)

    def calcVentaUsadosNacionales(self):
        monto = 0

        for venta in self.ventas:
            monto += venta.montoTotalVenta()

        return monto



class Comprador:
    def __init__(self, nombre, dni):
        self.nombre = nombre
        self.dni = dni
    
    def __str__(self):
        return F"{self.nombre}, {self.dni}"
    

class Venta:
    def __init__(self, fecha, comprador):
        self.fecha = fecha
        self.comprador = comprador
        self.detalleVenta = []
    
    def agregarDetalleVenta(self, detalle_venta):
        self.detalleVenta.append(detalle_venta)

    def montoTotalVenta(self):
        monto = 0
        for detVenta in self.detalleVenta:
            monto += detVenta.verMonto()
        
        return monto

class DetalleVenta:
    def __init__(self, venta, monto, producto):
        self.venta = venta
        self.monto = monto
        self.producto = producto
    
    def verMonto(self):
        return self.monto


class Accesorio:
    def __init__(self, nombre, precio):
        self.nombre = nombre
        self.precio = precio
    
    def verPrecio(self):
        return self.precio

    def __str__(self):
        return F"{self.nombre}"


class Duenio:
