class Vehiculo:
    def __init__(self, marca, modelo, patente, precio, km, estado):
        self.marca = marca
        self.modelo = modelo
        self.patente = patente
        self.precio = precio
        self.km = km
        self.estado = estado
        self.duenio = None

    def agregarDuenio(self, duenio):
        if(self.estado == "ceroKm"):
            print("El vehiculo no posee dueño anterior, pues es 0 Km")
        else:
            self.duenio = duenio


class Pais:
    def __init__(self, nombre, impuesto):
        self.nombre = nombre
        self.impuesto = impuesto

    def verImpuesto(self):
        return self.impuesto
    
    def __str__(self):
        return F"{self.nombre}"

class Auto(Vehiculo):
    def __init__(self, marca, modelo, patente, precio, km, estado, pais):
        super().__init__(marca, modelo, patente, precio, km, estado)
        self.pais = pais

    def esNacional(self):
        return (self.pais.__str__() == "Argentina")
    def verEstado(self):
        return self.estado
    def verPrecio(self):
        return self.precio + self.pais.verImpuesto()


class Moto(Vehiculo):
    def __init__(self, marca, modelo, patente, precio, km, estado):
        super().__init__(marca, modelo, patente, precio, km, estado)


class Camioneta(Vehiculo):
    def __init__(self, marca, modelo, patente, precio, km, estado):
