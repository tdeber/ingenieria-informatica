from typing import List
from datetime import datetime



class Comision:
    def __init__(self, fecha_inicio: datetime, id, titular):
        self.fecha_inicio = fecha_inicio
        self.id = id
        self.titular = titular
        self.alumnos: list[Alumno] = []

    def agregar_alumno(self, alumno):
        self.alumnos.append(alumno)

    def listar_alumnos(self):
        for alumno in self.alumnos:
            print(alumno.nombre)



class Catedra:
    def __init__(self, nombre, docentes):
        self.nombre = nombre
        self.docentes = docentes
        self.comisiones:list[Comision] = []

    def agregarComision(self, comision):
        self.comisiones.append(comision)

    def listar_alumnos_anioencurso(self):
        for comision in self.comisiones:
            if comision.fecha_inicio == datetime.today():
                comision.listar_alumnos()



