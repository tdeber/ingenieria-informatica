            self.tarifa_por_hora = tarifa_por_hora

    def getHoras(self):
        return self.horas_trabajadas
    
    def getTarifaPorHora(self):
         return self.tarifa_por_hora


class CalcularSalario:
     @staticmethod
     def calcular_salario(empleado:Empleado):
        return (empleado.getHoras() * empleado.getTarifaPorHora())

