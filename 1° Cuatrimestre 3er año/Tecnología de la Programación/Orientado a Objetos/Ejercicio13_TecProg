from abc import ABC, abstractmethod

class InterfazProducto(ABC):
    def __init__(self, nombre, descuento):
        self.nombre = nombre
        self.descuento = descuento

    def getDesceunto(self):
        return self.descuento

class Alimentos(InterfazProducto):
    def __init__(self,nombre, descuento):
        self.nombre = nombre
        self.descuento = descuento

class Limpieza(InterfazProducto):
    def __init__(self,nombre, descuento):
        self.nombre = nombre
        self.descuento = descuento

