class UsuarioDTO:
    def __init__(self, usuario, apellido, nombre, correo):
        self.usuario = usuario
        self.apellido = apellido
        self.nombre = nombre
        self.correo = correo
        self.roles = []

    def getUsuario(self):
        return self.usuario
    
    def getApellido(self):
        return self.apellido
    
    def getNombre(self):
