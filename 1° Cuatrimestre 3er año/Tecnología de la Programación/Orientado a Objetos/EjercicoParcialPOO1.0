class Universidad:
    def __init__(self, nombre):
        self.nombre = nombre
        self.comedores = []
        self.facultades = []
        self.usuariosDTO = []

    def getNombre(self):
        return self.nombre
    
    def agregarComedor(self, comedor: ComedorDTR):
        self.comedores.append(comedor)

    def agregarFacultad(self, faculdad: Facultad):
        self.facultades.append(faculdad)

    def agregarUsuarioDTO(self, usuarioDTO: UsuarioDTO):
        self.usuariosDTO.append(usuarioDTO)

    def listarComensalesConMasRoles(self):
        for usuarioDTO in self.usuariosDTO:
            usuarioDTO.ComensalmasRoles()
