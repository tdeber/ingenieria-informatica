from typing import List
from datetime import datetime
from abc import ABC, abstractmethod

class Facultad:
    def __init__(self, sigla):
        self.sigla = sigla


class Entrega:
    def __init__(self, fecha:datetime, cupon, comedor):
        self.fecha = fecha
        self.cupon = cupon
        self.comedor = comedor




class Cupon:
    def __init__(self, identificador:str, fechaCompra:datetime):
        self.identificador = identificador
        self.fechaCompra = fechaCompra
        self.entrega = None

    def getIdentidicador(self):
        return self.identificador
    
    def getFechaCompra(self):
        return self.fechaCompra
    
    def addEntrega(self, entrega: Entrega):
        self.entrega = entrega
    


